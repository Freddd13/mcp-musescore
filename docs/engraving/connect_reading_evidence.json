  "decisions": [
    {
      "location": "p4 H through p5 first system",
      "status": "visible grouping and conventional rhythmic reading checked with whole-bar arithmetic",
      "lesson": "7:4 eighths differ from 3:2 eighths, but 6:4 eighths equal 3:2 eighths per note. Ordinary eighth pairs, ties and final quarter variant remain distinct."
    },
    {
      "location": "p4 H third bar simile",
      "status": "visible omission pattern; dynamic interpretation remains an inference, not author confirmation",
      "lesson": "If simile abbreviates recurring dynamic swells, the publisher choice conflicts with Gould 109; articulation and tuplet omission have separate conditions. No automatic recommendation or source edit."
    },
    {
      "location": "p2 D / p4 G third system / p6 J",
      "status": "visible musical roles and textual order, not internal playback scope",
      "lesson": "Independent layer dynamics, hand transfers and repeated f/mf transitions serve different reading tasks; do not merge by location or duplicate text."
    },
    {
      "location": "p6 final system L",
      "status": "visible separate black and white heads, stems and continuation",
      "lesson": "Different held and moving roles may share an onset with separated heads; horizontal offset is not proof of a new time point or a spacing defect."
    },
    {
      "location": "p7 M-N / p8 Q ending",
      "status": "complete visual context, no performance or project reconstruction",
      "lesson": "A held chord, fermata or perceived close does not terminate all subsequent material; retain independent octave, continuation and final hand-gesture boundaries."
    }
  ],
