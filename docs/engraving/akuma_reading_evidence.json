  "decisions": [
    {
      "location": "p1 introduction / A / p3 E / p6 J-K",
      "status": "visible relationships and reading inference",
      "lesson": "Follow the slow theme as it moves between staves and layers; hand, staff and voice are different. Do not turn an empty staff into proof of an idle hand."
    },
    {
      "location": "p2 C systems 4-6 / p5 H systems 1-3",
      "status": "visible figures and measured PDF geometry",
      "lesson": "Corresponding recurring material keeps the same internal barline locations and pair gaps. Adjacent rows are not one uniform grid."
    },
    {
      "location": "C first bar, fast layer first two quarter beats",
      "status": "notation read from enlarged image, exact arithmetic; not source-object or MIDI evidence",
      "lesson": "A thirty-second rest plus thirteen thirty-seconds and a final sixteenth. One visible shared head and coincident glyph records must not become guessed extra attacks."
    },
    {
      "location": "p4 F first two systems",
      "status": "visible material and measured coincident internal barlines, interpreted alongside Gould 489",
      "lesson": "Line-finding risk needs complete row silhouettes and entry differences; neither coordinate equality nor a general rule proves a necessary edit here."
    },
    {
      "location": "p4 G / p3 E / p6 ending",
      "status": "visible cues with unresolved source scope",
      "lesson": "Separate dotted voice-leading, slurs, ties, octave scope, pedal and tempo. Line geometry alone does not identify exact internal voice or playback."
    },
    {
      "location": "p2 system 2 to 3",
      "status": "visible open line end, cross-line tie, notation duration and vector check",
      "lesson": "A 4/4 bar is split after two quarter beats. Both rows contain 2.5 bar equivalents; visible spans are not separate source measures, and a line break does not reset accidental or counting state. Native capability untested."
    }
