  "reading_decisions": {
    "A030_tremolo": "Keep one4-quarter alternating action and three-stroke unmeasured convention;not eight quarters or fixed32nd-rate expansion.",
    "A030_B": "Preserve stable repeated seven-head shape;lower1/2-beat midpoint lies in slightly wider fourth-to-fifth gap. More-uniform candidate must retain actual middle entry.",
    "A030_D": "Lower p0,upper pp1/2,lower melody mp1 quarter offsets;preserve layers and entrances.",
    "A030_TempoI": "p5s3same-pitch black/white heads and auxiliary stems not duplicate attacks or third staff;no blanket rest filling.",
    "A030_tempo": "p4s6lastbar half then caesura,eighth rest,three eighths;Poco meno before H. p5TempoI differs from p6Klocal a tempo after riten.",
    "A032_L": "p5s5upper3.5-quarter waiting before new last-eighth attack;lower activity continues.",
    "A032_N": "p6s4non rit.and full rest/release;lower pprepares before N,upper ppenters after quarter rest at N;not free waiting.",
    "A032_short_bar": "p7s1temporary3/4contains five16th tuplets1quarter,one low quarter,one quarter rest;upper first head receives tie,then new quarter and rest. Oreturns common time.",
    "A032_gliss": "p8s1wave with gliss.label differs from dashed voice guides;exact pitch/key endpoints not fully specified by visible ordinary heads.",
    "A032_final_ottava": "Slanted lead-in and numeral placement require exact start/scope confirmation;no automatic transposition from numeral x alone."
