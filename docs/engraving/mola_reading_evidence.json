      "paragraph": "Formatting first paragraph",
      "finding": "Chinese upper corners reversed relative to official English: for ordinary double-sided binding English places odd right-hand page numbers upper right, even left-hand numbers upper left.",
      "supporting_revisited_gould_printed_pages": [
        483,
        484
      ],
      "condition": "Distinguish physical recto/verso and printed page numbering from PDF ordinal. Not an unconditional validation of one-sided or tablet numbering."
    },
    {
      "zh_pdf_page": 5,
      "zh_printed_page": 3,
      "en_pdf_page": 5,
      "en_printed_page": 3,
      "paragraph": "Parts first and second paragraphs",
      "finding": "English each line is not internal polyphonic voice. The measure-number paragraph applies to parts by comparison with full score; Chinese wording obscures this.",
      "condition": "Do not add clefs to every internal voice, omit line context, or confuse cautionary symbols with effective state changes."
    },
    {
      "zh_pdf_page": 8,
      "zh_printed_page": 6,
      "en_pdf_page": 8,
      "en_printed_page": 6,
      "paragraph": "Paper and Binding, Parts first paragraph",
      "finding": "English A4-to-B4 endpoints are inclusive. Chinese strict-between wording is also inconsistent with its following A4 minimum sentence.",
      "condition": "This is orchestral part delivery guidance, not a universal solo piano paper-size test."
    }
