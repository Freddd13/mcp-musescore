  "usable_judgments": [
    {
      "id": "MOLA-ENTRY-STATE",
      "source_pdf_pages": [
        5,
        10
      ],
      "figure": 3,
      "reader_task": "Prepare a state change before a line turn, then recover current clef/key/meter and position.",
      "action": "Inspect both cautionary context and actual next-line state; distinguish rest count from bar-range navigation.",
      "exception": "Internal voices are not lines; not every rest or layer needs duplicated cues."
    },
    {
      "id": "MOLA-REST-NAVIGATION",
      "source_pdf_pages": [
        5,
        10
      ],
      "figure": 4,
      "reader_task": "Stay oriented during a long rest and recognize a real audible entry cue.",
      "action": "Retain meaningful changes and landmarks; check performer, hand and external audible context before proposing cue material.",
      "exception": "One idle piano staff does not mean the performer rests; do not duplicate already visible other-hand material automatically."
    },
    {
      "id": "MOLA-ACTION-AND-STATE",
      "source_pdf_pages": [
        5,
        10
      ],
      "figure": 5,
      "reader_task": "Have time to prepare an action and identify the active instrument/state at entry.",
      "action": "Separate preparation from effective range in diagnosis.",
      "exception": "Analogy does not authorize adding piano hand changes, pedal directives or shortening held notes."
    },
    {
      "id": "MOLA-FINAL-RENDER",
      "source_pdf_pages": [
        8,
        12
      ],
      "figure": 7,
      "reader_task": "Read ownership and placement after layout or extraction changes.",
      "action": "Check final native rendered labels and linework as well as semantic anchors.",
      "exception": "A source bad example does not establish that the current MuseScore runtime has the same defect."
    },
    {
      "id": "MOLA-READING-LOAD",
      "source_pdf_pages": [
        7
      ],
      "reader_task": "Follow similar material at a reasonably predictable visual pace.",
      "action": "Ask why similar systems change density; preserve local symbol and cross-part timing needs.",
      "exception": "No fixed bar count, head equality, page grid or universal spacing score follows from this paragraph."
    },
    {
      "id": "MOLA-PERFORMANCE-CONDITION",
      "source_pdf_pages": [
        7,
        8
      ],
      "reader_task": "Actually see, locate and turn the printed performance material.",
      "action": "Carry reader type, distance, stand sharing, medium, two-hand tasks and real page turns as conditions.",
      "exception": "Orchestral staff/paper/line-count requirements are not blanket solo piano thresholds; harp pedaling is not piano pedaling."
    }
  ],
